---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.name }}</title>
    <link>{{ site.url }}/</link>
    <description>{{ site.description }}</description>
    <language>{{ site.lang }}</language>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    {%- if collections.stories | length %}
    <lastBuildDate>{{ collections.stories[0].data.date | rfc822 }}</lastBuildDate>
    {%- endif %}
    {%- for story in collections.stories %}
    <item>
      <title>{{ story.data.title }}</title>
      <link>{{ site.url }}{{ story.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ story.url }}</guid>
      <pubDate>{{ story.data.date | rfc822 }}</pubDate>
      <dc:creator xmlns:dc="http://purl.org/dc/elements/1.1/">{{ site.author.name }}</dc:creator>
      <description>{{ story.data.dek }}</description>
      <content:encoded><![CDATA[{{ story.templateContent | safe }}]]></content:encoded>
    </item>
    {%- endfor %}
  </channel>
</rss>
