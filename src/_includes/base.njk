<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

{#- the CMS writes its optional overrides nested under `seo` -#}
{%- set ovTitle = seo.seoTitle if seo else none %}
{%- set ovDesc  = seo.seoDescription if seo else none %}
{%- set metaTitle = seoTitle or ovTitle or (title + " — " + site.name if title else site.title) %}
{%- set metaDesc  = seoDescription or ovDesc or description or dek or site.description %}
{%- set metaUrl   = site.url + page.url %}
{%- set metaImage = site.url + (cover or site.ogImage) %}

<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDesc | metaText(160) }}">
<meta name="author" content="{{ site.author.name }}">
<meta name="robots" content="{% if noindex %}noindex, follow{% else %}index, follow, max-image-preview:large, max-snippet:-1{% endif %}">
<link rel="canonical" href="{{ metaUrl }}">

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:title" content="{{ metaTitle }}">
<meta property="og:description" content="{{ metaDesc | metaText(200) }}">
<meta property="og:url" content="{{ metaUrl }}">
<meta property="og:image" content="{{ metaImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ coverAlt or (site.name + ' — founder stories, written by ' + site.author.name) }}">
{%- if ogType == 'article' %}
<meta property="article:published_time" content="{{ date | isoStamp }}">
<meta property="article:author" content="{{ site.author.name }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ metaTitle }}">
<meta name="twitter:description" content="{{ metaDesc | metaText(200) }}">
<meta name="twitter:image" content="{{ metaImage }}">

<meta name="theme-color" content="{{ site.themeColor.light }}" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="{{ site.themeColor.dark }}" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/assets/style.css">

<!-- Set the theme before first paint so there is no white flash. -->
<script>
(function () {
  try {
    var t = localStorage.getItem('fieldnotes:theme');
    if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
})();
</script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

<div id="progress" aria-hidden="true"></div>
<a class="skip-link" href="#main">Skip to content</a>

<nav class="nav" id="nav" aria-label="Primary">
  <div class="nav-inner">
    <a class="brand" href="/">{{ site.name }}<span>{{ site.tagline }}</span></a>
    <div class="nav-right">
      <div class="navlinks">
        <a href="/#stories">Stories</a>
        <a href="/#notes" data-secondary>Notes</a>
        <a href="/#services" data-secondary>Services</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </div>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch colour theme">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</nav>

<main id="main">
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <p class="label">© {{ site.name }} · founder storytelling &amp; brand communication</p>
    <div class="socials">
      <a href="{{ site.author.linkedin }}" rel="me">LinkedIn</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="mailto:{{ site.author.email }}">Email</a>
    </div>
  </div>
</footer>

{% if ogType == 'article' %}{% include "schema-story.njk" %}{% else %}{% include "schema-site.njk" %}{% endif %}

<script src="/assets/site.js" defer></script>
</body>
</html>
